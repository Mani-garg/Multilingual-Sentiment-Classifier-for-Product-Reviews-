# ==============================================================================
# Environment Configuration for Multilingual Sentiment Classifier
# ==============================================================================

# Core Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Reproducibility
RANDOM_SEED=42

# Dataset Configuration
DATASET_SOURCE_ID=amazon_reviews_multi
DATASET_REVISION=1.0.0
RAW_DATA_PATH=data/raw/multilingual_reviews.jsonl
INTERIM_DATA_PATH=data/interim/cleaned_reviews.jsonl
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_PATH=data/sample/multilingual_reviews_sample.jsonl

# Pretrained Model Selection
# Multilingual transformer checkpoint supporting en, de, fr, es, it, zh, ja, etc.
MODEL_CHECKPOINT=distilbert-base-multilingual-cased
MODEL_REVISION=main
MAX_SEQUENCE_LENGTH=128

# Training Hyperparameters
TRAIN_BATCH_SIZE=32
EVAL_BATCH_SIZE=64
EPOCHS=3
LEARNING_RATE=3e-5
WEIGHT_DECAY=0.01
WARMUP_RATIO=0.1
GRADIENT_CLIP_NORM=1.0
MIXED_PRECISION=false
EARLY_STOPPING_PATIENCE=2
USE_CLASS_WEIGHTS=true

# Artifact Directories
OUTPUT_DIR=artifacts/transformer
BASELINE_ARTIFACT_DIR=artifacts/baseline
TRANSFORMER_ARTIFACT_DIR=artifacts/transformer
ONNX_ARTIFACT_DIR=artifacts/onnx
REPORTS_DIR=artifacts/reports

# Optimization & Inference Settings
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider
ONNX_OPSET_VERSION=17
QUANTIZATION_MODE=dynamic_int8
INFERENCE_BACKEND=onnx
NUM_INFERENCE_THREADS=4

# FastAPI Serving Configuration
API_HOST=0.0.0.0
API_PORT=8000
MAX_REQUEST_TEXT_LENGTH=5000
MAX_TEXTS_PER_REQUEST=64
MAX_CONCURRENT_REQUESTS=10
INFERENCE_BATCH_SIZE=32
DYNAMIC_BATCH_MAX_WAIT_MS=20
REQUEST_TIMEOUT_SECONDS=10.0
API_KEY_ENABLED=false
API_KEY=
CORS_ORIGINS=["*"]
